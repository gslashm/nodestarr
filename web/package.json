{
  "name": "nodestarr-web",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.1.0",
  "type": "module",
  "description": "Web UI for Nodestarr",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/precompress.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./tests/register.mjs --test \"tests/*.test.ts\""
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@lucide/svelte": "^1.57.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "uplot": "^1.6.32",
    "uqr": "^0.1.3",
    "yaml": "^2.9.1"
  }
