{
  "name": "Nodestarr",
  "short_name": "Nodestarr",
  "description": "Monitor, update and back up the containers on your server.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0d1220",
  "theme_color": "#121a2b",
  "icons": [
    {
      "src": "./icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
